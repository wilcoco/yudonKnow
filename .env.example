# 인터뷰어·분신을 돌리는 기저 LLM.
# 없으면 stub 모드로 뜬다 (발굴→카드→분신→공백→닻 동선은 그대로 돈다).
#
# 접합 순서: Gemini(기본) → Anthropic(대체) → stub.
# 못 박고 싶으면: auto | gemini | anthropic | stub
YDK_LLM_PROVIDER=auto

# -- Gemini (기본 기저) -------------------------------------------------
# (1) Gemini API 로 붙는 경우 — aistudio.google.com 에서 발급
GOOGLE_API_KEY=
YDK_GEMINI_MODEL=gemini-3.5-pro

# (2) Vertex AI 로 붙는 경우 — 채우면 GOOGLE_API_KEY 없이 이쪽이 우선한다.
#     Cloud Run 에서는 서비스 계정 기본 자격증명이 그대로 쓰인다.
YDK_VERTEX_PROJECT=
YDK_VERTEX_LOCATION=us-central1

# -- Anthropic (대체 기저) ----------------------------------------------
# 기저 교체 가능성이 전략 자산이라는 규약의 실물 증거. 없어도 서비스는 뜬다.
ANTHROPIC_API_KEY=
YDK_ANTHROPIC_MODEL=claude-opus-4-5

YDK_MAX_TOKENS=8000

# 저장소. 미설정 시 sqlite:///./data/yudonknow.db
# Cloud SQL / Railway 의 postgres:// URL 은 자동 정규화된다.
DATABASE_URL=

# 화면 언어. 기본은 브라우저 Accept-Language 자동 (한국어 아니면 영어).
# 대회 규정 6조가 영어 지원을 통과 조건으로 둔다 — docs/hackathon.md
# 사용자는 화면 우상단 토글이나 ?lang=en / ?lang=ko 로 언제든 바꾼다.

# 데모 시드. 1 이면 DB 가 비었을 때만 yudon(ko)·dale(en) 두 사람을 심는다.
# 심사자가 첫 화면에서 바로 만져볼 것이 있어야 한다.
YDK_SEED=

# 발굴/검증 정책
YDK_INTERVIEW_TURNS=7          # 한 세션 목표 질문 수
YDK_RETRIEVAL_TOP_K=6          # 분신이 한 답에 끌어올 카드 수
YDK_EXPLORE_QUOTA=0.25         # 검색 결과 중 신규·저인용 카드 강제 배정 비율
YDK_CONFIDENCE_FLOOR=0.35      # 이 아래면 답하지 않고 공백(gap)으로 넘긴다
YDK_ANCHOR_MIN_REPORTS=2       # 현장 검증 배지에 필요한 최소 적용 보고 수
